// A Z31 300ZX digital cluster, built from copilot widgets, wired to the bus:
// the TRACK mode scene.
//
// The same panel with a warning band from 5000 rpm and a red band from 6000,
// and the mode named at the top right. A starting point, like the sport scene.
//
// The same panel as z31.scene, for the cluster at node 0x01 in normal driving
// mode, with each instrument bound to the gauge it reads: the tachometer bank
// to RPM over 0..7000, the speed cells to VSS in mph, the columns down the
// right to coolant, oil pressure and battery volts in the units printed beside
// them. The dashboard derives its CAN subscription from these bindings and
// writes each reading onto its widget every frame; where a gauge has no
// reading yet the authored value -- or the fuel gauge's demo sweep -- shows.
//
// Laid out from a photograph of the real panel at key-on, which is why every
// tachometer segment is lit: the cluster self-tests before the engine starts
// and the bank fills to the envelope printed on its lens. In use the columns
// light left to right with the revs, and their height is boost -- the top row
// is full boost, which is the detail that makes this instrument odd and worth
// copying properly.
//
// This is the upper part of the panel only. The odometer, trip meters, average
// speed and distance-to-empty sit well below the area this screen covers, so
// including them here would put them somewhere they are not. What is left is
// scaled to the room that leaves.
//
// Everything is labelled in words rather than drawn as symbols. A telltale
// nobody can read is worse than a word, and the panel has room for the word.
{
  "width": 2400,
  "height": 900,
  "node": "0x01",
  "root": {
    "type": "panel",
    "rect": [0, 0, 2400, 900],
    "background": "#05070a",
    "name": "cluster",

    "children": [
      // The etched grid, under everything and dim enough to read as texture.
      { "type": "grid", "rect": [0, 0, 2400, 900], "name": "lens",
        "pitch_x": 24, "pitch_y": 24, "width": 1, "color": "#0e1a16" },

      // ---- fuel, down the left where the tank gauge belongs ----
      { "type": "label", "rect": [24, 40, 150, 30], "text": "FUEL",
        "color": "#c9d1d9", "scale": 4, "align": "center" },
      { "type": "frame", "rect": [46, 80, 108, 532], "color": "#3d4650" },
      { "type": "segbar", "rect": [52, 86, 96, 520], "name": "fuel",
        "value": 0.62, "vertical": true, "segments": 20, "gap": 5,
        "fill": "#3fb950", "track": "#0c1410",
        "animate": { "property": "value", "from": 0.95, "to": 0.10,
                     "duration_ms": 45000, "repeat": "loop" },
        "bind": { "gauge": "FUEL_LEVEL", "min": 0, "max": 100 } },
      { "type": "ruler", "rect": [158, 86, 14, 520], "name": "fuel_scale",
        "ticks": 11, "major_every": 5, "length": 6, "width": 2,
        "color": "#5a6570", "major_color": "#9aa6b2", "vertical": true },
      { "type": "label", "rect": [176, 88, 40, 30], "text": "F",
        "color": "#9aa6b2", "scale": 4 },
      { "type": "label", "rect": [176, 578, 40, 30], "text": "E",
        "color": "#9aa6b2", "scale": 4 },

      // ---- speed ----
      { "type": "label", "rect": [244, 60, 170, 34], "text": "SPEED",
        "color": "#c9d1d9", "scale": 4 },
      // Outlines, not filled shapes: the arrows on the glass are hollow until
      // the lamp behind them comes on.
      { "type": "line", "rect": [212, 110, 120, 76], "name": "turn_left",
        "color": "#3fb950", "width": 5, "closed": true,
        "points": [[0.0, 0.5], [0.42, 0.0], [0.42, 0.28], [1.0, 0.28],
                   [1.0, 0.72], [0.42, 0.72], [0.42, 1.0]] },
      { "type": "line", "rect": [1450, 110, 120, 76], "name": "turn_right",
        "color": "#3fb950", "width": 5, "closed": true,
        "points": [[1.0, 0.5], [0.58, 0.0], [0.58, 0.28], [0.0, 0.28],
                   [0.0, 0.72], [0.58, 0.72], [0.58, 1.0]] },
      {
        "type": "frame", "rect": [370, 40, 1050, 268], "color": "#6e7681",
        "name": "speed_box",
        "children": [
          // Three digits' worth of cells with only the last lit at a
          // standstill. The dark ones are the unlit segments a real panel
          // shows in deep red, which is most of what makes it look powered.
          { "type": "sevenseg", "rect": [96, 18, 620, 176], "name": "speed",
            "text": "0", "color": "#5ce68a", "ghost": "#2a0d12",
            "thickness": 18, "digits": 3,
            "bind": { "gauge": "VSS", "unit": "mph" } },
          { "type": "label", "rect": [740, 40, 180, 30], "text": "km/h",
            "color": "#3d2a1a", "scale": 4 },
          { "type": "label", "rect": [740, 100, 200, 44], "text": "MPH",
            "color": "#5ce68a", "scale": 6 },
          { "type": "panel", "rect": [184, 198, 14, 14], "background": "#5ce68a" },
          { "type": "label", "rect": [150, 220, 82, 30], "text": "35",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "panel", "rect": [374, 198, 14, 14], "background": "#5ce68a" },
          { "type": "label", "rect": [340, 220, 82, 30], "text": "45",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "panel", "rect": [564, 198, 14, 14], "background": "#5ce68a" },
          { "type": "label", "rect": [530, 220, 82, 30], "text": "55",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "panel", "rect": [754, 198, 14, 14], "background": "#5ce68a" },
          { "type": "label", "rect": [720, 220, 82, 30], "text": "65",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "panel", "rect": [944, 198, 14, 14], "background": "#5ce68a" },
          { "type": "label", "rect": [910, 220, 82, 30], "text": "75",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
        ],
      },
      { "type": "label", "rect": [1450, 230, 300, 30], "text": "CRUISE",
        "color": "#9aa6b2", "scale": 4 },
      { "type": "led", "rect": [1610, 226, 32, 32], "name": "cruise",
        "color": "#5ce68a", "level": 0.0, "glow": 0.22 },
      // The mode, said in words where the eye goes for warnings.
      { "type": "label", "rect": [2040, 20, 340, 30], "name": "mode", "text": "TRACK",
        "color": "#f85149", "scale": 4, "align": "right" },

      // ---- tachometer ----
      {
        "type": "panel", "rect": [212, 350, 1400, 500], "background": "#00000000",
        "name": "tacho",
        "children": [
          { "type": "label", "rect": [0, 6, 170, 34], "text": "TACH",
            "color": "#c9d1d9", "scale": 4 },
          // The face beside these reads "x100r/min", so the binding divides
          // by a hundred: the bus carries 3500 rpm and the cells show 35.
          { "type": "sevenseg", "rect": [190, 0, 88, 88], "name": "rpm_digits",
            "text": "0", "color": "#5ce68a", "ghost": "#2a0d12", "thickness": 6,
            "digits": 2,
            "bind": { "gauge": "RPM", "divide": 100 } },
          { "type": "label", "rect": [300, 30, 340, 30], "text": "x100r/min",
            "color": "#9aa6b2", "scale": 4 },

          // Forty columns of stacked dashes on one grid, cut to the envelope
          // the lens carries.
          { "type": "segbar", "rect": [60, 100, 1240, 320], "name": "rpm",
            "value": 1.0, "segments": 40, "gap": 8,
            "divisions": 34, "div_gap": 3,
            "profile": [0.28, 0.30, 0.32, 0.34, 0.37, 0.40, 0.43, 0.46, 0.50, 0.54,
                        0.58, 0.62, 0.66, 0.70, 0.74, 0.78, 0.81, 0.84, 0.87, 0.89,
                        0.91, 0.93, 0.95, 0.96, 0.97, 0.98, 0.99, 1.00, 1.00, 0.99,
                        0.98, 0.97, 0.95, 0.93, 0.91, 0.89, 0.86, 0.83, 0.80, 0.77],
            "fill": "#3fb950", "track": "#0c1410",
            "warn": 0.71, "warn_fill": "#d29922", "danger": 0.86, "danger_fill": "#f85149",
            "bind": { "gauge": "RPM", "min": 0, "max": 7000 } },
          // The curve on the glass. Its points come from the same profile the
          // cells are cut to, so the printed line and the cut it describes are
          // one curve rather than two guesses at it.
          { "type": "line", "rect": [60, 100, 1240, 320], "name": "power_curve",
            "width": 4, "color": "#d29922",
            "points": [[0.000, 0.72], [0.013, 0.72], [0.037, 0.70], [0.062, 0.68],
                       [0.087, 0.66], [0.113, 0.63], [0.138, 0.60], [0.163, 0.57],
                       [0.188, 0.54], [0.212, 0.50], [0.237, 0.46], [0.263, 0.42],
                       [0.287, 0.38], [0.312, 0.34], [0.338, 0.30], [0.362, 0.26],
                       [0.388, 0.22], [0.412, 0.19], [0.438, 0.16], [0.463, 0.13],
                       [0.487, 0.11], [0.512, 0.09], [0.537, 0.07], [0.562, 0.05],
                       [0.588, 0.04], [0.613, 0.03], [0.637, 0.02], [0.662, 0.01],
                       [0.688, 0.00], [0.713, 0.00], [0.738, 0.01], [0.762, 0.02],
                       [0.787, 0.03], [0.812, 0.05], [0.838, 0.07], [0.863, 0.09],
                       [0.887, 0.11], [0.912, 0.14], [0.938, 0.17], [0.963, 0.20],
                       [0.988, 0.23], [1.000, 0.23]] },

          { "type": "label", "rect": [20, 436, 80, 30], "text": "0.5",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [115, 436, 80, 30], "text": "1",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [306, 436, 80, 30], "text": "2",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [496, 436, 80, 30], "text": "3",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [687, 436, 80, 30], "text": "4",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [878, 436, 80, 30], "text": "5",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [1069, 436, 80, 30], "text": "6",
            "color": "#d29922", "scale": 4, "align": "center" },
          { "type": "label", "rect": [1260, 436, 80, 30], "text": "7",
            "color": "#d29922", "scale": 4, "align": "center" },
          { "type": "label", "rect": [1360, 436, 340, 30], "text": "x1000r/min",
            "color": "#9aa6b2", "scale": 4 },
        ],
      },

      // ---- water, oil and volts, down the right ----
      //
      // Framed, with a tick scale beside each, the way the factory gauges are
      // ruled on the glass. Their cells are solid: only the tachometer bank is
      // broken up across its width, and a gauge this narrow cut the same way
      // reads as noise rather than as a column.
      {
        "type": "panel", "rect": [1740, 60, 660, 470], "background": "#00000000",
        "children": [
          { "type": "label", "rect": [-20, 0, 200, 30], "text": "TEMP",
            "color": "#c9d1d9", "scale": 4, "align": "center" },
          { "type": "frame", "rect": [24, 38, 96, 372], "color": "#3d4650" },
          { "type": "segbar", "rect": [30, 44, 84, 360], "name": "coolant",
            "value": 0.3, "vertical": true, "segments": 20, "gap": 5,
            "fill": "#3fb950", "track": "#0c1410",
            "bind": { "gauge": "CLNT", "unit": "°F", "min": 120, "max": 270 } },
          { "type": "ruler", "rect": [124, 44, 14, 360], "name": "coolant_scale",
            "ticks": 11, "major_every": 5, "length": 6, "width": 2,
            "color": "#5a6570", "major_color": "#9aa6b2", "vertical": true },
          { "type": "label", "rect": [146, 38, 110, 30], "text": "270",
            "color": "#9aa6b2", "scale": 4 },
          { "type": "label", "rect": [146, 380, 110, 30], "text": "120",
            "color": "#9aa6b2", "scale": 4 },
          { "type": "label", "rect": [-20, 424, 200, 30], "text": "F",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [210, 0, 200, 30], "text": "OIL PRES",
            "color": "#c9d1d9", "scale": 4, "align": "center" },
          { "type": "frame", "rect": [254, 38, 96, 372], "color": "#3d4650" },
          { "type": "segbar", "rect": [260, 44, 84, 360], "name": "oil",
            "value": 0.62, "vertical": true, "segments": 20, "gap": 5,
            "fill": "#3fb950", "track": "#0c1410",
            "bind": { "gauge": "OIL_PRES", "unit": "psi", "min": 0, "max": 90 } },
          { "type": "ruler", "rect": [354, 44, 14, 360], "name": "oil_scale",
            "ticks": 11, "major_every": 5, "length": 6, "width": 2,
            "color": "#5a6570", "major_color": "#9aa6b2", "vertical": true },
          { "type": "label", "rect": [376, 38, 110, 30], "text": "90",
            "color": "#9aa6b2", "scale": 4 },
          { "type": "label", "rect": [376, 380, 110, 30], "text": "0",
            "color": "#9aa6b2", "scale": 4 },
          { "type": "label", "rect": [210, 424, 200, 30], "text": "PSI",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
          { "type": "label", "rect": [440, 0, 200, 30], "text": "VOLTS",
            "color": "#c9d1d9", "scale": 4, "align": "center" },
          { "type": "frame", "rect": [484, 38, 96, 372], "color": "#3d4650" },
          { "type": "segbar", "rect": [490, 44, 84, 360], "name": "volts",
            "value": 0.74, "vertical": true, "segments": 20, "gap": 5,
            "fill": "#3fb950", "track": "#0c1410",
            "bind": { "gauge": "BAT_VOL", "min": 10, "max": 16 } },
          { "type": "ruler", "rect": [584, 44, 14, 360], "name": "volts_scale",
            "ticks": 11, "major_every": 5, "length": 6, "width": 2,
            "color": "#5a6570", "major_color": "#9aa6b2", "vertical": true },
          { "type": "label", "rect": [606, 38, 110, 30], "text": "16",
            "color": "#9aa6b2", "scale": 4 },
          { "type": "label", "rect": [606, 380, 110, 30], "text": "10",
            "color": "#9aa6b2", "scale": 4 },
          { "type": "label", "rect": [440, 424, 200, 30], "text": "V",
            "color": "#9aa6b2", "scale": 4, "align": "center" },
        ],
      },

      // The two lamps that live with those gauges, named rather than drawn.
      { "type": "roundrect", "rect": [1830, 560, 190, 56], "name": "oil_lamp",
        "background": "#f0326e", "radius": 8 },
      { "type": "label", "rect": [1830, 568, 190, 40], "text": "OIL",
        "color": "#2a0410", "scale": 4, "align": "center", "valign": "middle" },
      { "type": "roundrect", "rect": [2060, 560, 190, 56], "name": "batt_lamp",
        "background": "#f0326e", "radius": 8 },
      { "type": "label", "rect": [2060, 568, 190, 40], "text": "BATT",
        "color": "#2a0410", "scale": 4, "align": "center", "valign": "middle" },
    ],
  },
}
